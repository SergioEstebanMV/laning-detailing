# ======================================================
# Eme Detailing - .gitignore
# Proyecto FrontEnd HTML / CSS / JavaScript
# ======================================================

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Configuración de editores
.vscode/
.idea/
*.swp
*.swo

# Archivos temporales
*.tmp
*.temp
*.log

# Archivos comprimidos o respaldos
*.zip
*.rar
*.7z
*.tar
*.gz
*.bak

# Carpetas de respaldo o imágenes originales pesadas
# Estas NO se suben al repositorio
originales/
raw/
backup/
backups/
imagenes-originales/
img-originales/

# Archivos de diseño editables pesados
*.psd
*.ai
*.xd
*.fig
*.sketch

# Dependencias si algún día usas Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Variables de entorno o datos sensibles
.env
.env.local
.env.*.local

# Cache
.cache/
.parcel-cache/
.next/
dist/
build/

# ======================================================
# IMPORTANTE:
# No ignorar estas imágenes porque la página las necesita:
#
# logo.jpeg
# image.png
# img/
#
# La carpeta img/ debe subirse al repositorio para que funcione
# la galería en GitHub Pages.
# ======================================================